///|
test "basic test" {
  let key : Bytes = b"0123456789ABCDEF"
  let key_fa = fixedarray_byte_of_bytes(key)
  let encrypt_cooked = camlpdf_caml_aes_cook_encrypt_key(
    key_fa,
    0,
    key_fa.length(),
  )
  inspect(
    bytes_of_fixedarray_byte(encrypt_cooked),
    content=(
      #|b"32107654BA98FEDC)h_*\x1e^j\x1e\x5c\x1fS&\x1aZ\x17ed\xca\xe1\xd8z\x94\x8b\xc6&\x8b\xd8\xe0<\xd1\xcf\x85\xf3!\xdfV\x89\xb5T\x90\xaf>\x8cp\x93\xefC\xf5\x15\xfd\x00D\x9cHT\xd43v\xd8\xa4\xa0\x99\x9bQ\xc4\x1d\xee@XU\xba\x94k#b0\xcb\xba\xf9a+\x02\x1a\xf9sW\xa0m\x18t\xc2]\xd3\xce;<\xc0d\x91[\xb3316\xabG\xf3kx\x89\xc8W\x9b\xd863(\xeb\x07\x05\x83\xac\xf4n\xfb%<9\x89\xd7\x09\xc3\xa1<\x0e\xc6\x22\x90\xfa\xa8\xd9\xb5\xc6\x91\x08\xe2\xdcA\xa9\xde\xd2\x87\x8bN(/R\xfb\xee\xbe\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0a"
    ),
  )
  inspect(encrypt_cooked.length(), content="241")
  let decrypt_cooked = camlpdf_caml_aes_cook_decrypt_key(
    key_fa,
    0,
    key_fa.length(),
  )
  inspect(
    bytes_of_fixedarray_byte(decrypt_cooked),
    content=(
      #|b"\x08\xe2\xdcA\xa9\xde\xd2\x87\x8bN(/R\xfb\xee\xbesc\xc0D.\x13+C\xc1\xae\xc2M\xcd\x05\xa4W\x12\x9f3\xf8]p\xeb\x07\xef\xbd\xe9\x0e\x0c\xabf\x1a\x81\xf8\x0c\x1bO\xef\xd8\xff\xb2\xcd\x02\x09\xe3\x16\x8f\x14\x90Q.%\xce\x17\xd4\xe4\xfd\x22\xda\xf6Q\xdb\x8d\x1d\x9d9Y\x8a^F\xfa\xc135\x0e\x12\xac\xf9W\xebX_\x0e\xa5\xc3\x7f\xa3Kms\xf4\xd3\x9f\xccY\xf9\xa7\xec=-\x9b \xad\xee\xae\x0cW\x98\xf2\xbf\xad*f\x86\xd6\xa1<\xcc\x90\xc35,\xfav\x5c\xb3\xfa\xb2cv}\x5cZJFb\x09\xe0j\xb5i\x9f\x00\xc432107654BA98FEDC\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0a"
    ),
  )
  inspect(decrypt_cooked.length(), content="241")

  // 16 bytes
  let plaintext : Bytes = b"Time is precious"
  inspect(plaintext.length(), content="16")
  inspect(
    plaintext,
    content=(
      #|b"Time is precious"
    ),
  )
  let plaintext_fa = fixedarray_byte_of_bytes(plaintext)
  let ciphertext = FixedArray::make(16, b'\x00')
  let decrypted = FixedArray::make(16, b'\x00')
  camlpdf_caml_aes_encrypt(encrypt_cooked, 0, plaintext_fa, 0, ciphertext, 0)
  inspect(
    bytes_of_fixedarray_byte(ciphertext),
    content=(
      #|b"\xf3\x97\x09\xdf,\xdb\x87B@G\xbaN(f\x14\xb3"
    ),
  )
  camlpdf_caml_aes_decrypt(decrypt_cooked, 0, ciphertext, 0, decrypted, 0)
  inspect(
    bytes_of_fixedarray_byte(decrypted),
    content=(
      #|b"Time is precious"
    ),
  )
  assert_eq(plaintext_fa, decrypted)
}

///|
#callsite(autofill(loc))
fn aes_test_driver(
  cipher_key : Bytes,
  plaintext : Bytes,
  loc~ : SourceLoc,
) -> Unit raise Error {
  let cipher_key_fa = fixedarray_byte_of_bytes(cipher_key)
  let plaintext_fa = fixedarray_byte_of_bytes(plaintext)
  let encrypt_cooked = camlpdf_caml_aes_cook_encrypt_key(
    cipher_key_fa,
    0,
    cipher_key_fa.length(),
  )
  let decrypt_cooked = camlpdf_caml_aes_cook_decrypt_key(
    cipher_key_fa,
    0,
    cipher_key_fa.length(),
  )
  let ciphertext = FixedArray::make(16, b'\x00')
  camlpdf_caml_aes_encrypt(encrypt_cooked, 0, plaintext_fa, 0, ciphertext, 0)
  let decrypted = FixedArray::make(16, b'\x00')
  camlpdf_caml_aes_decrypt(decrypt_cooked, 0, ciphertext, 0, decrypted, 0)
  assert_eq(plaintext_fa, decrypted, loc~)
}

///|
fn u32_to_le_bytes(value : UInt) -> Bytes {
  Bytes::from_array([
    value.reinterpret_as_int().to_byte(),
    (value >> 8).reinterpret_as_int().to_byte(),
    (value >> 16).reinterpret_as_int().to_byte(),
    (value >> 24).reinterpret_as_int().to_byte(),
  ])
}

///|
test "AES test driver" {
  let key : Bytes = b"0123456789ABCDEF"
  let plaintext : Bytes = b"Time is precious"
  aes_test_driver(key, plaintext)
}

///|
test {
  let key : Bytes = b"0123456789ABCDEF"
  let key_array = fixedarray_byte_of_bytes(key)
  let p1 = get_u32(memory_of_fixedarray_byte(key_array), 0)
  let p2 = get_u32(memory_of_fixedarray_byte(key_array), 4)
  let p3 = get_u32(memory_of_fixedarray_byte(key_array), 8)
  let p4 = get_u32(memory_of_fixedarray_byte(key_array), 12)
  inspect(
    u32_to_le_bytes(p1),
    content=(
      #|b"3210"
    ),
  )
  inspect(
    u32_to_le_bytes(p2),
    content=(
      #|b"7654"
    ),
  )
  inspect(
    u32_to_le_bytes(p3),
    content=(
      #|b"BA98"
    ),
  )
  inspect(
    u32_to_le_bytes(p4),
    content=(
      #|b"FEDC"
    ),
  )
}

